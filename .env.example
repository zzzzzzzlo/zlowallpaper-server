# Local native MySQL credentials; .env is generated during setup.
# Do not overwrite an existing .env or commit actual passwords.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
AUTH_JWT_SECRET=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
COVER_CACHE_ENABLED=true
COVER_CACHE_TTL_SECONDS=21600
# AUTH_JWT_SECRET: Base64编码的至少32个随机字节，不提交真实值。

# OSS 私有 Bucket。真实密钥只写本机 .env，不提交或截图发送。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
# 新上传默认COS；如使用OSS，改为OSS并填写对应配置。旧文件按自身provider读取。
STORAGE_PROVIDER=COS
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
# COS_BUCKET包含APPID后缀，例如example-1250000000；COS_REGION例如ap-guangzhou。
# 例如 Region 为 cn-guangzhou，Endpoint 为 https://oss-cn-guangzhou.aliyuncs.com。
# ffprobe/ffmpeg 默认从 PATH 查找；部署机器可以指定绝对路径。
# FFPROBE_PATH=D:/MYSY2/mingw64/bin/ffprobe.exe
# FFMPEG_PATH=D:/MYSY2/mingw64/bin/ffmpeg.exe

# Optional local overrides (defaults are already in application configuration).
# SERVER_PORT=8080
# WALLPAPER_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# WALLPAPER_STORAGE_ROOT=D:/Codex/software/zlowallpaper-storage
# 可选：对外封面 URL 的 API 基础地址；省略时跟随 SERVER_PORT，默认本机8080。
# WALLPAPER_PUBLIC_BASE_URL=http://127.0.0.1:8080/api/v1
