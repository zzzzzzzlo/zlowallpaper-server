<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zlo.wallpaper.auth.mapper.SessionMapper">
    <sql id="columns">id, user_id, refresh_token_hash, created_at, expires_at, revoked_at</sql>
    <select id="selectById" resultType="com.zlo.wallpaper.auth.entity.Session">
        SELECT <include refid="columns"/> FROM sessions WHERE id = #{id}
    </select>
    <select id="selectByRefreshHash" resultType="com.zlo.wallpaper.auth.entity.Session">
        SELECT <include refid="columns"/> FROM sessions WHERE refresh_token_hash = #{hash}
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sessions (user_id, refresh_token_hash, created_at, expires_at)
        VALUES (#{userId}, #{refreshTokenHash}, #{createdAt}, #{expiresAt})
    </insert>
    <update id="revokeByRefreshHash">
        UPDATE sessions SET revoked_at = #{now}
        WHERE refresh_token_hash = #{hash} AND revoked_at IS NULL
    </update>
    <delete id="deleteExpired">DELETE FROM sessions WHERE expires_at &lt; #{cutoff}</delete>
</mapper>
